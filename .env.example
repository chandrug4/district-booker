# Copy to .env for local runs. .env is gitignored - keep it that way,
# it holds your EmailJS private key.

TARGET_URL_BASE=https://in.bookmyshow.com/movies/chennai/the-odyssey/buytickets/ET00480917

TO_EMAIL=you@example.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_FAILURE_TEMPLATE_ID=template_dx9v2zk
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional: residential proxy, e.g. http://user:pass@host:port
PROXY_URL=

# Optional tuning
# Kill switch: set to anything to pause the checker, delete the line to resume.
# The value is not interpreted - STOP=0 pauses exactly like STOP=1.
# STOP=paused until payday
# Pin exact dates (YYYY-MM-DD or YYYYMMDD, comma-separated). When set, this
# wins over WATCH_WEEKDAY/DATES_TO_CHECK. Leave blank for the weekday rule.
WATCH_DATES=
# Weekday to watch: a name ("monday") or 0=Sunday..6=Saturday. Default: monday.
WATCH_WEEKDAY=monday
# How many upcoming matching dates to watch (1 = the coming one only).
DATES_TO_CHECK=2
MAX_ATTEMPTS=3
BLOCK_ALERT_THRESHOLD=3

# New Features Configuration
START_TIME=           # e.g. 18:00
END_TIME=             # e.g. 23:00
MAX_CONCURRENCY=3     # Number of tabs to open in parallel
CONSOLIDATE_ALERTS=true # Set to true to receive a single digest email
